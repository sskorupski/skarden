{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/famille.schema.json",
  "title": "Famille — botanique ou zoologique",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nom",
    "regne"
  ],
  "properties": {
    "id": {
      "$ref": "socle.schema.json#/$defs/id"
    },
    "nom": {
      "$ref": "socle.schema.json#/$defs/nom"
    },
    "nom_latin": {
      "type": "string"
    },
    "regne": {
      "enum": [
        "vegetal",
        "animal"
      ],
      "description": "Une plante ne désigne qu'une famille végétale, un animal qu'une famille animale."
    }
  }
}
