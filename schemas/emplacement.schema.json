{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/emplacement.schema.json",
  "title": "Emplacement — où ça pousse chez moi",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nom",
    "interieur"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identifiant en kebab-case, égal au nom du fichier."
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "interieur": {
      "type": "boolean"
    },
    "exposition": {
      "enum": [
        "plein-soleil",
        "mi-ombre",
        "ombre"
      ]
    },
    "support": {
      "enum": [
        "pleine-terre",
        "bac",
        "pot",
        "jardiniere",
        "serre"
      ]
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^medias/"
      },
      "uniqueItems": true,
      "description": "Chemins depuis la racine du dépôt."
    }
  }
}
