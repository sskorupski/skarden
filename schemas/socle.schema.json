{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/socle.schema.json",
  "title": "Socle — les définitions communes aux deux règnes",
  "description": "Repris par $ref depuis les schémas des collections : une définition commune n'existe qu'ici.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identifiant en kebab-case, égal au nom du fichier."
    },
    "lien": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "L'identifiant d'une fiche d'une autre collection."
    },
    "liens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/lien"
      },
      "uniqueItems": true
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Une date AAAA-MM-JJ."
    },
    "date_ou_vide": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "statut": {
      "enum": [
        "en-cours",
        "terminee",
        "perdue"
      ]
    },
    "plages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/plage"
      }
    },
    "plage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parametre",
        "etat"
      ],
      "anyOf": [
        {
          "required": [
            "min"
          ]
        },
        {
          "required": [
            "max"
          ]
        }
      ],
      "properties": {
        "parametre": {
          "enum": [
            "temperature-c",
            "humidite-pct",
            "salinite-g-l",
            "ph"
          ],
          "description": "Le nom dit l'unité des bornes."
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "etat": {
          "enum": [
            "actif",
            "dormance",
            "a-eviter",
            "mortel"
          ]
        }
      },
      "description": "Une borne absente laisse la plage ouverte de ce côté."
    },
    "phase": {
      "enum": [
        "dormance",
        "reveil",
        "activite",
        "reproduction",
        "preparation"
      ]
    },
    "mois": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Mois de l'année, de 1 à 12."
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phases"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "phase",
                "mois"
              ],
              "properties": {
                "phase": {
                  "$ref": "#/$defs/phase"
                },
                "mois": {
                  "$ref": "#/$defs/mois"
                }
              }
            }
          }
        }
      },
      "description": "Les façons de mener l'espèce sur une année ; un lot en retient une."
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^medias/"
      },
      "uniqueItems": true,
      "description": "Chemins depuis la racine du dépôt."
    }
  }
}
