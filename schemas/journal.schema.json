{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/journal.schema.json",
  "title": "Entrée du journal — un événement daté d'une culture ou d'un élevage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "evenement"
  ],
  "oneOf": [
    {
      "required": [
        "culture"
      ]
    },
    {
      "required": [
        "elevage"
      ]
    }
  ],
  "properties": {
    "date": {
      "$ref": "socle.schema.json#/$defs/date"
    },
    "culture": {
      "$ref": "socle.schema.json#/$defs/lien"
    },
    "elevage": {
      "$ref": "socle.schema.json#/$defs/lien"
    },
    "evenement": {
      "type": "string"
    },
    "effectif": {
      "type": "integer",
      "minimum": 0,
      "description": "Le nombre d'individus, pour une entrée d'élevage."
    },
    "photos": {
      "$ref": "socle.schema.json#/$defs/photos"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "elevage"
        ],
        "not": {
          "required": [
            "culture"
          ]
        }
      },
      "then": {
        "properties": {
          "evenement": {
            "enum": [
              "introduction",
              "ponte",
              "eclosion",
              "comptage",
              "renouvellement-substrat",
              "changement-d-eau",
              "mise-en-dormance",
              "reveil",
              "division",
              "prelevement",
              "traitement",
              "observation",
              "perte"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "culture"
        ],
        "not": {
          "required": [
            "elevage"
          ]
        }
      },
      "then": {
        "properties": {
          "evenement": {
            "enum": [
              "semis",
              "repiquage",
              "plantation",
              "rempotage",
              "taille",
              "arrosage",
              "fertilisation",
              "traitement",
              "floraison",
              "recolte",
              "observation",
              "perte"
            ]
          },
          "effectif": {
            "not": {},
            "description": "réservé aux entrées d'un élevage."
          }
        }
      }
    }
  ]
}
