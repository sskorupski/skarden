{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/journal.schema.json",
  "title": "Entrée du journal — un événement daté",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "culture",
    "evenement"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "culture": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "evenement": {
      "enum": [
        "semis",
        "repiquage",
        "plantation",
        "rempotage",
        "taille",
        "arrosage",
        "fertilisation",
        "traitement",
        "floraison",
        "recolte",
        "observation",
        "perte"
      ]
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^medias/"
      },
      "uniqueItems": true,
      "description": "Chemins depuis la racine du dépôt."
    }
  }
}
