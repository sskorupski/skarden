{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sskorupski/skarden/schemas/journal.schema.json",
  "title": "Entrée du journal — un événement daté d'une culture, d'un élevage ou d'une réalisation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "evenement"
  ],
  "oneOf": [
    {
      "required": [
        "culture"
      ]
    },
    {
      "required": [
        "elevage"
      ]
    },
    {
      "required": [
        "realisation"
      ]
    }
  ],
  "properties": {
    "date": {
      "$ref": "socle.schema.json#/$defs/date"
    },
    "culture": {
      "$ref": "socle.schema.json#/$defs/lien"
    },
    "elevage": {
      "$ref": "socle.schema.json#/$defs/lien"
    },
    "evenement": {
      "type": "string"
    },
    "effectif": {
      "type": "integer",
      "minimum": 0,
      "description": "Le nombre d'individus, pour une entrée d'élevage."
    },
    "realisation": {
      "$ref": "socle.schema.json#/$defs/lien"
    },
    "avis": {
      "type": "array",
      "minItems": 1,
      "description": "Un avis par participant ; seule une dégustation d'une réalisation en porte.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "participant",
          "criteres"
        ],
        "properties": {
          "participant": {
            "$ref": "socle.schema.json#/$defs/texte",
            "description": "Un prénom ou un pseudonyme : le dépôt est public."
          },
          "criteres": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "enum": [
                "couleur",
                "limpidite",
                "nez",
                "bouche",
                "texture",
                "equilibre",
                "finale",
                "ensemble"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "commentaire": {
            "$ref": "socle.schema.json#/$defs/texte"
          }
        }
      }
    },
    "photos": {
      "$ref": "socle.schema.json#/$defs/photos"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "elevage"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "culture"
              ]
            },
            {
              "required": [
                "realisation"
              ]
            }
          ]
        }
      },
      "then": {
        "properties": {
          "evenement": {
            "enum": [
              "introduction",
              "ponte",
              "eclosion",
              "comptage",
              "renouvellement-substrat",
              "changement-d-eau",
              "mise-en-dormance",
              "reveil",
              "division",
              "prelevement",
              "traitement",
              "observation",
              "perte"
            ]
          },
          "avis": {
            "not": {},
            "description": "réservé à une dégustation d'une réalisation."
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "culture"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "elevage"
              ]
            },
            {
              "required": [
                "realisation"
              ]
            }
          ]
        }
      },
      "then": {
        "properties": {
          "evenement": {
            "enum": [
              "semis",
              "repiquage",
              "plantation",
              "rempotage",
              "taille",
              "arrosage",
              "fertilisation",
              "traitement",
              "floraison",
              "recolte",
              "observation",
              "perte"
            ]
          },
          "effectif": {
            "not": {},
            "description": "réservé aux entrées d'un élevage."
          },
          "avis": {
            "not": {},
            "description": "réservé à une dégustation d'une réalisation."
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "realisation"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "culture"
              ]
            },
            {
              "required": [
                "elevage"
              ]
            }
          ]
        }
      },
      "then": {
        "properties": {
          "evenement": {
            "enum": [
              "observation",
              "degustation",
              "incident",
              "ajustement"
            ]
          },
          "effectif": {
            "not": {},
            "description": "réservé aux entrées d'un élevage."
          }
        },
        "if": {
          "properties": {
            "evenement": {
              "const": "degustation"
            }
          }
        },
        "then": {
          "required": [
            "avis"
          ]
        },
        "else": {
          "properties": {
            "avis": {
              "not": {},
              "description": "réservé à une dégustation d'une réalisation."
            }
          }
        }
      }
    }
  ]
}
